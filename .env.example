# Target API Host
TARGET_HOST=https://tokendance.space

# Proxy Port (defaults to 7860 if not specified)
# PORT=7860

# API Keys for rotation, separated by comma (Use purely placeholder values here)
KEY=sk-key1,sk-key2

# Client authentication password for the proxy and control panel (Use purely placeholder values here)
PASSWORD=your_password_here

# Outbound proxy (optional, e.g. http://127.0.0.1:7890)
OUTBOUND_PROXY=

# Rotation mode: round-robin or exhaustion
KEY_MODE=round-robin
